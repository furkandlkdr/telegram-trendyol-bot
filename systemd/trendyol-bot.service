[Unit]
Description=Trendyol Price Tracking Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=furkan
WorkingDirectory=/home/furkan/telegram-trendyol-bot
Environment=PATH=/home/furkan/telegram-trendyol-bot/venv/bin
ExecStart=/home/furkan/telegram-trendyol-bot/venv/bin/python main.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trendyol-bot

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/furkan/telegram-trendyol-bot

[Install]
WantedBy=multi-user.target
