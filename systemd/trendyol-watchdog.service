[Unit]
Description=Trendyol Bot Watchdog
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=furkan
WorkingDirectory=/home/furkan/telegram-trendyol-bot
Environment=PATH=/home/furkan/telegram-trendyol-bot/venv/bin
ExecStart=/home/furkan/telegram-trendyol-bot/venv/bin/python watchdog.py
Restart=always
RestartSec=30
KillMode=mixed

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trendyol-watchdog

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/furkan/telegram-trendyol-bot

[Install]
WantedBy=multi-user.target
